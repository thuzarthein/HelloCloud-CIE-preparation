{
    "Version": "2012-10-17",
    "Statement" :[
        {
            "Effect":"Allow",
            "Action":[
                "autoscaling:Describe*",
                "cloudinwatch:Describe*",
                "cloudwatch:Get*",
                "cloudwatch:List*",
                "logs:Get",
                "logs:List",
                "logs:Startquery",
                "logs:Stopquery",
